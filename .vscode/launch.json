{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug active file",
      "type": "lldb",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.o",
      "args": [
        ""
      ],
      "cwd": "${fileDirname}",
      "env": {
        "DYLD_LIBRARY_PATH": "/usr/local/lib"
      },
      "preLaunchTask": "build active file",
      "stopOnEntry": false
    },
    {
      "name": "Python: Flask",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "application.py",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--no-debugger",
        "--no-reload"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}